---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { CLUSTERS } from '../../data/clusters';
import { SERVICES } from '../../data/services';

const articles = await getCollection('learn');
const byCluster = CLUSTERS.map((cluster) => ({
  cluster,
  articles: articles
    .filter((a) => a.data.cluster === cluster.id)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  service: SERVICES.find((s) => s.slug === cluster.serviceSlug),
})).filter((g) => g.articles.length > 0);

const icons = import.meta.glob<{ default: ImageMetadata }>('../../assets/icons/*.png');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Learn — plain-English guides to getting found',
  description:
    'Guides for local business owners on getting found by customers: Google Maps, search, reviews, websites, ads and AI recommendations.',
  url: `${SITE.url}/learn/`,
  hasPart: byCluster.flatMap((g) =>
    g.articles.map((a) => ({
      '@type': 'Article',
      headline: a.data.title,
      url: `${SITE.url}/learn/${a.id}/`,
    }))
  ),
};
---

<Base
  title={`Learn — plain-English guides to getting found — ${SITE.name}`}
  description="Every question local business owners ask us about getting found — answered in plain English. Google Maps, reviews, websites, ads and AI recommendations."
  schema={schema}
>
  <section class="bg-navy-950 py-16">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <p class="text-sm font-bold uppercase tracking-widest text-teal-400">Learn</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Every question, answered in plain English
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-200">
        The questions local business owners actually ask us — answered honestly, without jargon, and
        free. Steal the playbook, or <a href="/contact/" class="font-semibold text-teal-400 hover:text-teal-500">have us run it for you</a>.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-6xl space-y-14 px-4 sm:px-6">
      {
        byCluster.map(async ({ cluster, articles: clusterArticles, service }) => {
          const icon = await icons[`../../assets/icons/${cluster.icon}.png`]();
          return (
            <section id={cluster.id} aria-labelledby={`h-${cluster.id}`}>
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-50 p-2.5">
                  <Image src={icon.default} alt="" width="64" height="64" class="h-9 w-9 object-contain" />
                </div>
                <div>
                  <h2 id={`h-${cluster.id}`} class="text-2xl font-extrabold tracking-tight text-navy-900">
                    {cluster.label}
                  </h2>
                  <p class="mt-1 max-w-2xl text-sm leading-6 text-navy-700">{cluster.description}</p>
                </div>
              </div>
              <div class="mt-6 grid gap-4 md:grid-cols-2">
                {clusterArticles.map((a) => (
                  <a
                    href={`/learn/${a.id}/`}
                    class="group block rounded-2xl border border-navy-100 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg"
                  >
                    <h3 class="text-base font-bold text-navy-900 group-hover:text-brand-600">{a.data.question}</h3>
                    <p class="mt-2 text-sm leading-6 text-navy-700">{a.data.description}</p>
                    <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-brand-500">
                      Read the answer
                      <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
              {service && (
                <p class="mt-4 text-sm text-navy-600">
                  Done reading, want it done?{' '}
                  <a href={`/services/${service.slug}/`} class="font-semibold text-brand-600 hover:text-brand-500">
                    {service.title} →
                  </a>
                </p>
              )}
            </section>
          );
        })
      }
    </div>
  </section>

  <CtaBand
    title="Prefer answers about your business, specifically?"
    subtitle="The free check-up applies everything in these guides to your actual listing, website and market — and tells you what to fix first."
  />
</Base>
