---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { CLUSTERS } from '../../data/clusters';
import { SERVICES } from '../../data/services';

export async function getStaticPaths() {
  const articles = await getCollection('learn');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;

const cluster = CLUSTERS.find((c) => c.id === data.cluster);
const allArticles = await getCollection('learn');
const relatedArticles = data.related
  .map((slug) => allArticles.find((a) => a.id === slug))
  .filter((a) => a !== undefined);
const clusterSiblings = allArticles.filter((a) => a.data.cluster === data.cluster && a.id !== article.id);
const linkedServices = data.services
  .map((slug) => SERVICES.find((s) => s.slug === slug))
  .filter((s) => s !== undefined);

const url = `${SITE.url}/learn/${article.id}/`;
const iso = (d: Date) => d.toISOString().split('T')[0];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: iso(data.pubDate),
    dateModified: iso(data.updatedDate ?? data.pubDate),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: url,
    about: cluster?.label,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['[data-direct-answer]'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: `${SITE.url}/learn/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  ...(data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: [
            {
              '@type': 'Question',
              name: data.question,
              acceptedAnswer: { '@type': 'Answer', text: data.directAnswer },
            },
            ...data.faqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: { '@type': 'Answer', text: f.a },
            })),
          ],
        },
      ]
    : []),
];

const icons = import.meta.glob<{ default: ImageMetadata }>('../../assets/icons/*.png');
const icon = cluster ? await icons[`../../assets/icons/${cluster.icon}.png`]() : null;
---

<Base title={`${data.title} — ${SITE.name}`} description={data.description} schema={schema}>
  <article>
    <header class="bg-navy-950 py-14">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <nav aria-label="Breadcrumb" class="text-sm text-navy-300">
          <a href="/" class="hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/learn/" class="hover:text-white">Learn</a>
          {
            cluster && (
              <>
                <span class="mx-2">/</span>
                <a href={`/learn/#${cluster.id}`} class="hover:text-white">
                  {cluster.label}
                </a>
              </>
            )
          }
        </nav>
        <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{data.title}</h1>
        <p class="mt-3 text-sm text-navy-300">
          By {SITE.name} · Updated {iso(data.updatedDate ?? data.pubDate)}
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
      <!-- Direct answer: the quotable block search features and AI engines lift -->
      <section
        data-direct-answer
        class="rounded-2xl border-l-4 border-teal-500 bg-navy-50/70 p-6"
        aria-label="Short answer"
      >
        <h2 class="text-base font-extrabold text-navy-900">{data.question}</h2>
        <p class="mt-2 text-base leading-7 text-navy-800">{data.directAnswer}</p>
      </section>

      {
        data.keyFacts.length > 0 && (
          <section class="mt-8 rounded-2xl border border-navy-100 bg-white p-6 shadow-sm" aria-label="Key facts">
            <h2 class="text-sm font-bold uppercase tracking-widest text-teal-600">Key facts</h2>
            <ul class="mt-3 space-y-2">
              {data.keyFacts.map((fact) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-navy-800">
                  <span class="mt-0.5 text-brand-500">▸</span>
                  {fact}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div
        class="prose prose-slate mt-10 max-w-none prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-navy-900 prose-p:text-navy-800 prose-a:font-semibold prose-a:text-brand-600 prose-li:text-navy-800"
      >
        <Content />
      </div>

      {
        data.faqs.length > 0 && (
          <section class="mt-12" aria-label="Frequently asked questions">
            <h2 class="text-2xl font-extrabold tracking-tight text-navy-900">More questions, answered</h2>
            <div class="mt-5 space-y-4">
              {data.faqs.map((f) => (
                <details class="group rounded-2xl border border-navy-100 bg-white p-6 shadow-sm">
                  <summary class="flex cursor-pointer list-none items-center justify-between text-base font-bold text-navy-900">
                    {f.q}
                    <span class="ml-4 text-brand-500 transition group-open:rotate-45">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                      </svg>
                    </span>
                  </summary>
                  <p class="mt-3 text-sm leading-7 text-navy-700">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        linkedServices.length > 0 && (
          <aside class="mt-12 rounded-2xl bg-navy-950 p-7 text-center">
            <p class="text-lg font-extrabold text-white">Rather have this handled for you?</p>
            <p class="mx-auto mt-2 max-w-md text-sm text-navy-300">
              This is exactly what we do all day:
              {linkedServices.map((s, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={`/services/${s.slug}/`} class="font-semibold text-teal-400 hover:text-teal-500">
                    {s.title}
                  </a>
                </>
              ))}
            </p>
            <a
              href="/contact/"
              class="mt-5 inline-block rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-navy-950 transition hover:bg-amber-400"
            >
              Get your free check-up
            </a>
          </aside>
        )
      }

      {
        (relatedArticles.length > 0 || clusterSiblings.length > 0) && (
          <nav class="mt-12" aria-label="Related guides">
            <h2 class="text-sm font-bold uppercase tracking-widest text-teal-600">Keep reading</h2>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {[...new Map([...relatedArticles, ...clusterSiblings].map((a) => [a.id, a])).values()]
                .slice(0, 4)
                .map((a) => (
                  <li>
                    <a
                      href={`/learn/${a.id}/`}
                      class="block h-full rounded-xl border border-navy-100 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow"
                    >
                      <span class="text-sm font-bold text-navy-900">{a.data.title}</span>
                      <span class="mt-1 block text-xs leading-5 text-navy-600">{a.data.question}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        )
      }
    </div>
  </article>

  <CtaBand />
</Base>
